{
  "name": "Kimi",
  "enabled": true,
  "is_default": false,
  "spec": {
    "protocol_version": 1,
    "image": "docker.io/moonbitcloud/mooncraft-agent-runtime:0.1.1",
    "agent": "kimi_code",
    "model": "moonshotai/kimi-k2.6",
    "provider": "openrouter",
    "send": ["mooncraft-runtime-send"],
    "container_home": "/root",
    "secrets": [
      {
        "source": "admin_openrouter_key_pool",
        "env": "MOONCRAFT_AI_API_KEY"
      }
    ]
  }
}
