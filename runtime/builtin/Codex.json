{
  "name": "Codex",
  "enabled": true,
  "is_default": true,
  "spec": {
    "protocol_version": 1,
    "image": "docker.io/moonbitcloud/mooncraft-agent-runtime:0.1.3",
    "agent": "codex",
    "model": "openai/gpt-5.4-mini",
    "provider": "openrouter",
    "send": ["mooncraft-runtime-send"],
    "container_home": "/root",
    "secrets": [
      {
        "source": "mooncraft_ai_api_key",
        "env": "MOONCRAFT_AI_API_KEY"
      }
    ]
  }
}
