{
  "name": "Claude",
  "enabled": true,
  "is_default": false,
  "spec": {
    "protocol_version": 2,
    "image": "docker.io/moonbitcloud/mooncraft-agent-runtime:0.3.0",
    "agent": "claude",
    "model": "anthropic/claude-sonnet-4.5",
    "auth": {
      "kind": "openrouter_api_key",
      "secret": {
        "source": "mooncraft_ai_api_key",
        "target": {
          "type": "env",
          "name": "MOONCRAFT_AI_API_KEY"
        }
      }
    }
  }
}
