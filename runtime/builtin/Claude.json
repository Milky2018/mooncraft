{
  "name": "Claude",
  "enabled": true,
  "is_default": false,
  "spec": {
    "protocol_version": 1,
    "image": "docker.io/moonbitcloud/mooncraft-agent-runtime:0.1.4",
    "agent": "claude_code",
    "model": "anthropic/claude-sonnet-4.5",
    "provider": "openrouter",
    "send": ["mooncraft-runtime-send"],
    "container_home": "/home/mooncraft",
    "container_user": "mooncraft",
    "secrets": [
      {
        "source": "mooncraft_ai_api_key",
        "env": "MOONCRAFT_AI_API_KEY"
      }
    ]
  }
}
