{
  "id": "frontend-dashboard",
  "version": "0.1.0",
  "name": "Frontend Dashboard",
  "summary": "Pure MoonBit frontend dashboard template for static product pages and analytics shells.",
  "category": "frontend",
  "app_shape": "frontend-static",
  "storage": "none",
  "tenant_requirement": "none",
  "workspace_kind": "module",
  "workspace_dir": "workspace",
  "entrypoints": {
    "frontend_main": "main.mbt"
  },
  "preview": {
    "kind": "static",
    "public_dir": "public",
    "health_path": "/__health",
    "frontend_module": "moonbitcloud/frontend-dashboard"
  },
  "validation": {
    "build_workspace": "moon build",
    "run_preview": "moon run --manifest-path <repo>/moon.work --target native services/control-plane -- run-static-preview <port> <public_dir>"
  },
  "editable_files": [
    "main.mbt",
    "public"
  ],
  "knowledge_doc": "knowledge/templates/frontend-dashboard.md"
}
