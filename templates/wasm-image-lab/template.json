{
  "id": "wasm-image-lab",
  "version": "0.1.0",
  "name": "Wasm Image Lab",
  "summary": "Frontend-only MoonBit wasm-gc image lab with procedural scenes, upload, and filter controls.",
  "category": "frontend",
  "app_shape": "wasm-image-editor",
  "storage": "none",
  "tenant_requirement": "none",
  "workspace_kind": "module",
  "workspace_dir": "workspace",
  "entrypoints": {
    "frontend_main": "main.mbt"
  },
  "preview": {
    "kind": "static",
    "public_dir": "public",
    "health_path": "/__health",
    "frontend_module": "moonbitcloud/wasm-image-lab",
    "frontend_backend": "wasm-gc",
    "build_artifacts": [
      {
        "backend": "wasm-gc",
        "encoding": "base64",
        "target_path": "app.wasm.txt"
      }
    ]
  },
  "validation": {
    "build_workspace": "moon build",
    "run_preview": "moon run --manifest-path <repo>/moon.work --target native services/control-plane -- run-static-preview <port> <public_dir>"
  },
  "editable_files": [
    "main.mbt",
    "public"
  ],
  "knowledge_doc": "knowledge/templates/wasm-image-lab.md"
}
