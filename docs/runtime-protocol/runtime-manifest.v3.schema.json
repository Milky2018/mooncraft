{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mooncraft.dev/runtime-protocol/runtime-manifest.v3.schema.json",
  "title": "MoonCraft Runtime Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "image"],
  "properties": {
    "protocol_version": {
      "const": 3
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "secrets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secret"
      },
      "default": []
    }
  },
  "$defs": {
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/secret_target"
        }
      }
    },
    "secret_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["env", "file"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "env"
              }
            }
          },
          "then": {
            "required": ["name"],
            "not": {
              "required": ["path"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": ["path"],
            "not": {
              "required": ["name"]
            }
          }
        }
      ]
    }
  }
}
