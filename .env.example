# MoonBit Cloud local configuration.
#
# Copy this file to .env when you need local overrides. `just` loads .env
# automatically, and the control plane uses these values at runtime.

# Official Codex executor image. Override this for local image testing, PR images,
# rollbacks, or digest-pinned production deployments.
MOONBITCLOUD_CODEX_DOCKER_IMAGE=docker.io/moonbitcloud/codex:codex-0.123.0-node24

# Codex model used by MoonBit Cloud. Keep this explicit so local Codex CLI
# config.toml cannot accidentally select a model your account cannot access.
MOONBITCLOUD_CODEX_MODEL=gpt-5.4

# Optional. Defaults to $HOME/.codex.
# MOONBITCLOUD_CODEX_HOME_HOST=/Users/<you>/.codex

# Optional. Defaults to /root.
# MOONBITCLOUD_CODEX_CONTAINER_HOME=/root

# Database configuration.
#
# Leave MOONBITCLOUD_DATABASE_URL unset for local dev/test; the control plane
# uses data/control-plane/state-v2.sqlite. Set it in production to use
# PostgreSQL through Morm.
# MOONBITCLOUD_DATABASE_URL=postgres://moonbitcloud:moonbitcloud@postgres:5432/moonbitcloud
# MOONBITCLOUD_POSTGRES_DB=moonbitcloud
# MOONBITCLOUD_POSTGRES_USER=moonbitcloud
# MOONBITCLOUD_POSTGRES_PASSWORD=change-me

# Production compose image and published host port.
# MOONBITCLOUD_IMAGE=756584956649.dkr.ecr.us-west-2.amazonaws.com/mbt-cloud/moonbitcloud:latest
# MOONBITCLOUD_HTTP_PORT=8080

# Optional GitHub OAuth configuration.
# MOONBITCLOUD_GITHUB_CLIENT_ID=
# MOONBITCLOUD_GITHUB_CLIENT_SECRET=
# MOONBITCLOUD_PUBLIC_BASE_URL=http://localhost:8080
