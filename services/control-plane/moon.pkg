import {
  "mooncraft/sdk",
  "oboard/mocket",
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/async/process",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/ref",
  "moonbitlang/core/buffer",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitlang/x/codec/base64",
  "moonbitlang/x/crypto",
  "moonbitlang/async/fs" @async_fs,
  "oboard/morm/engine" @db,
  "oboard/morm/engine/sqlite3" @morm_sqlite,
  "moonbit-community/postgres/client" @pg,
}

supported_targets = "native"

options(
  "is-main": true,
  link: { "native": { "cc-link-flags": "-lsqlite3" } },
  "native-stub": [ "control_plane_process.c" ],
)
