import {
  "mooncraft/sdk" @sdk,
  "oboard/mocket",
  "moonbitlang/async" @async,
  "moonbitlang/async/http" @http,
  "moonbitlang/async/io" @io,
  "moonbitlang/async/socket" @socket,
  "moonbitlang/async/process" @process,
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/ref",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/core/string",
  "moonbitlang/x/codec/base64" @base64,
  "moonbitlang/x/crypto" @crypto,
  "moonbitlang/x/fs",
  "oboard/morm/engine" @db,
  "oboard/morm/engine/sqlite3" @morm_sqlite,
  "moonbit-community/postgres/client" @pg,
}

supported_targets = "native"

options(
  "is-main": true,
  link: { "native": { "cc-link-flags": "-lsqlite3" } },
  "native-stub": [ "control_plane_process.c" ],
)
